# Konfigurasi Aplikasi NETRI Exam Web
NEXT_PUBLIC_APP_NAME="Exam NETRI"
PROCTOR_EMERGENCY_CODE=000000 # 6-digit kode rahasia keluar darurat pengawas ruang
